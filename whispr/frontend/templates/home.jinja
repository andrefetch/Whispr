{% extends "layout.jinja" %}
{% block content %}
<section class="hero-section">
    <div class="hero-bg"></div>
    <svg class="hero-corner-squiggle hero-corner-squiggle-tl" viewBox="0 0 500 280" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <g filter="url(#crayon)">
            <path d="M 50 140 C 110 200, 170 80, 230 160 C 290 240, 350 100, 450 160" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
            <path d="M 50 140 C 110 200, 170 80, 230 160 C 290 240, 350 100, 450 160" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="1"/>
        </g>
    </svg>
    <svg class="hero-corner-squiggle hero-corner-squiggle-br" viewBox="0 0 500 280" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <g filter="url(#crayon)">
            <path d="M 40 140 C 100 60, 180 220, 250 140 C 320 60, 400 220, 460 140" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
            <path d="M 40 140 C 100 60, 180 220, 250 140 C 320 60, 400 220, 460 140" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="1"/>
        </g>
    </svg>
    <div class="hero-text">
        <svg class="hero-squiggle" viewBox="0 0 500 280" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
            <g filter="url(#crayon)">
                <path d="M 70 215 C 90 225, 110 220, 130 200 C 165 160, 180 85, 235 140 C 285 190, 275 265, 320 240 C 370 210, 370 75, 420 105"
                      fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" opacity="0.22"/>
                <path d="M 70 215 C 90 225, 110 220, 130 200 C 165 160, 180 85, 235 140 C 285 190, 275 265, 320 240 C 370 210, 370 75, 420 105"
                      fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"/>
                <path d="M 70 215 C 90 225, 110 220, 130 200 C 165 160, 180 85, 235 140 C 285 190, 275 265, 320 240 C 370 210, 370 75, 420 105"
                      fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" opacity="1"/>
            </g>
        </svg>
        <h1 class="hero-title">
            <span class="whispr-wordmark">Whispr</span>
        </h1>

        <p class="tagline fade-in fade-in-1">
            A free, <u class="highlight">open sourced</u> chatroom service that keeps your conversations yours. No data collected, no snooping, no catch.
        </p>

        <p class="tagline-cont fade-in fade-in-2">
            Well, what's holding you back?
        </p>

        <a href="{{ url_for('register') }}" class="tagline-button fade-in fade-in-3">
            <span>Get Started</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </a>
    </div>
</section>

<div class="scroll-indicator">
    <span class="section-area d-flex flex-column align-items-center">
     <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-90deg-down" viewBox="0 0 16 16">
  <path fill-rule="evenodd" d="M4.854 14.854a.5.5 0 0 1-.708 0l-4-4a.5.5 0 0 1 .708-.708L4 13.293V3.5A2.5 2.5 0 0 1 6.5 1h8a.5.5 0 0 1 0 1h-8A1.5 1.5 0 0 0 5 3.5v9.793l3.146-3.147a.5.5 0 0 1 .708.708z"/>
</svg> 
    </span>
  </div>

<section class="features d-flex justify-content-center text-center">
    <svg class="feature-squiggle feature-squiggle-1" viewBox="0 0 500 280" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <g filter="url(#crayon)">
            <path d="M 70 215 C 90 225, 110 220, 130 200 C 165 160, 180 85, 235 140 C 285 190, 275 265, 320 240 C 370 210, 370 75, 420 105"
                  fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"/>
            <path d="M 70 215 C 90 225, 110 220, 130 200 C 165 160, 180 85, 235 140 C 285 190, 275 265, 320 240 C 370 210, 370 75, 420 105"
                  fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="1"/>
        </g>
    </svg>
    <svg class="feature-squiggle feature-squiggle-2" viewBox="0 0 500 280" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <g filter="url(#crayon)">
            <path d="M 40 140 C 100 60, 180 220, 250 140 C 320 60, 400 220, 460 140"
                  fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
            <path d="M 40 140 C 100 60, 180 220, 250 140 C 320 60, 400 220, 460 140"
                  fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="1"/>
        </g>
    </svg>
    <svg class="feature-squiggle feature-squiggle-3" viewBox="0 0 500 280" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <g filter="url(#crayon)">
            <path d="M 80 200 C 140 120, 220 260, 280 160 C 340 80, 420 200, 460 150"
                  fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
            <path d="M 80 200 C 140 120, 220 260, 280 160 C 340 80, 420 200, 460 150"
                  fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="1"/>
        </g>
    </svg>
    <svg class="feature-squiggle feature-squiggle-4" viewBox="0 0 500 280" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <g filter="url(#crayon)">
            <path d="M 60 180 C 120 100, 200 240, 260 140 C 320 50, 380 230, 450 120"
                  fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
            <path d="M 60 180 C 120 100, 200 240, 260 140 C 320 50, 380 230, 450 120"
                  fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="1"/>
        </g>
    </svg>
    <svg class="feature-squiggle feature-squiggle-5" viewBox="0 0 500 280" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <g filter="url(#crayon)">
            <path d="M 50 140 C 110 200, 170 80, 230 160 C 290 240, 350 100, 450 160"
                  fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
            <path d="M 50 140 C 110 200, 170 80, 230 160 C 290 240, 350 100, 450 160"
                  fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="1"/>
        </g>
    </svg>
    <div class="section-area d-flex flex-column align-items-center">
        <p class="label">
            Why use Whispr?
        </p>
        <h2 class="features-title">
            We take privacy very seriously.
        </h2>
        <p class="features-items">Features that make chatting very easy, and very private.</p>
        <div class="feature-cards">
            <div class="feature-card">
                <div class="feature-card-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="4" y="10" width="16" height="10" rx="2"></rect>
                        <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                    </svg>
                </div>
                <h3>Privacy</h3>
                <p>Your conversations stay yours. No data collected, no snooping.</p>
            </div>
            <div class="feature-card">
                <div class="feature-card-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M15 9.5a3 3 0 0 0-3-1.5c-1.66 0-3 1-3 2.25s1.34 2 3 2.25 3 1 3 2.25S13.66 16 12 16a3 3 0 0 1-3-1.5"></path>
                        <path d="M12 6v2M12 16v2"></path>
                    </svg>
                </div>
                <h3>Free</h3>
                <p>Completely free to use. No hidden fees, no paywalls.</p>
            </div>
            <div class="feature-card">
                <div class="feature-card-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="8 7 3 12 8 17"></polyline>
                        <polyline points="16 7 21 12 16 17"></polyline>
                        <line x1="14" y1="5" x2="10" y2="19"></line>
                    </svg>
                </div>
                <h3>Open Sourced</h3>
                <p>Fully open source. Inspect, contribute, or self-host.</p>
            </div>
        </div>
    </div>
</section>

<footer class="site-footer">
    <div class="container">
        <p class="footer-copy">&copy; {{ current_year or 2026 }} Whispr</p>
    </div>
</footer>
{% endblock content %}