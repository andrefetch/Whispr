<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <link rel="icon" type="image/svg+xml" href="{{ url_for('static', filename='images/logo.svg') }}?v=2">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="{{ url_for('static', filename='css/typography/colors.css') }}" rel="stylesheet">
    <link href="{{ url_for('static', filename='css/main/styles.css') }}" rel="stylesheet">

</head>
<body>
    <svg class="global-defs" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <filter id="crayon" x="-8%" y="-8%" width="116%" height="116%">
                <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" seed="4" result="coarse"/>
                <feDisplacementMap in="SourceGraphic" in2="coarse" scale="6" result="wobble"/>
                <feTurbulence type="fractalNoise" baseFrequency="2.2" numOctaves="2" seed="9" result="grain"/>
                <feDisplacementMap in="wobble" in2="grain" scale="1.6"/>
            </filter>
        </defs>
    </svg>
    <div class="ambient-squiggles" aria-hidden="true">
        <svg class="ambient-squiggle ambient-squiggle-a" viewBox="0 0 500 280" xmlns="http://www.w3.org/2000/svg">
            <g filter="url(#crayon)">
                <path d="M 50 140 C 110 200, 170 80, 230 160 C 290 240, 350 100, 450 160" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
                <path d="M 50 140 C 110 200, 170 80, 230 160 C 290 240, 350 100, 450 160" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="1"/>
            </g>
        </svg>
        <svg class="ambient-squiggle ambient-squiggle-b" viewBox="0 0 500 280" xmlns="http://www.w3.org/2000/svg">
            <g filter="url(#crayon)">
                <path d="M 40 200 C 90 100, 180 260, 250 140 C 320 20, 400 220, 460 120" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
                <path d="M 40 200 C 90 100, 180 260, 250 140 C 320 20, 400 220, 460 120" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="1"/>
            </g>
        </svg>
        <svg class="ambient-squiggle ambient-squiggle-c" viewBox="0 0 500 280" xmlns="http://www.w3.org/2000/svg">
            <g filter="url(#crayon)">
                <path d="M 70 160 C 130 220, 210 90, 270 170 C 330 250, 390 120, 450 180" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
                <path d="M 70 160 C 130 220, 210 90, 270 170 C 330 250, 390 120, 450 180" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="1"/>
            </g>
        </svg>
        <svg class="ambient-squiggle ambient-squiggle-d" viewBox="0 0 500 280" xmlns="http://www.w3.org/2000/svg">
            <g filter="url(#crayon)">
                <path d="M 60 180 C 120 100, 200 240, 260 140 C 320 50, 380 230, 450 120" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
                <path d="M 60 180 C 120 100, 200 240, 260 140 C 320 50, 380 230, 450 120" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="1"/>
            </g>
        </svg>
    </div>
    <nav class="navbar navbar-expand-lg sticky-top site-navbar">
    <div class="container">
        <a class="navbar-brand fw-semibold d-inline-flex align-items-center gap-2" href="{{ url_for('home') }}">
            <img src="{{ url_for('static', filename='images/logo.svg') }}?v=2" alt="" width="32" height="32" class="brand-mark">
            <span class="brand-word">Whispr</span>
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                <li class="nav-item">
                    <a class="nav-link{% if request.endpoint == 'home' %} is-active{% endif %}" href="{{ url_for('home') }}">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link{% if request.endpoint == 'login' %} is-active{% endif %}" href="{{ url_for('login') }}">Login</a>
                </li>
                <li class="nav-item nav-divider d-none d-lg-block" aria-hidden="true"></li>
                <li class="nav-item">
                    <a class="btn btn-sm px-3 nav-cta{% if request.endpoint == 'register' %} is-active{% endif %}" href="{{ url_for('register') }}">
                        Sign Up
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>
{% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
        <div class="toast-stack" aria-live="polite" aria-atomic="true">
            {% for category, message in messages %}
                <div class="toast-item toast-{{ category }}" role="status" data-toast>
                    <div class="toast-icon" aria-hidden="true">
                        {% if category in ('success',) %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        {% elif category in ('danger', 'error') %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="15" y1="9" x2="9" y2="15"></line>
                                <line x1="9" y1="9" x2="15" y2="15"></line>
                            </svg>
                        {% elif category in ('warning',) %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                <line x1="12" y1="9" x2="12" y2="13"></line>
                                <line x1="12" y1="17" x2="12.01" y2="17"></line>
                            </svg>
                        {% else %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                            </svg>
                        {% endif %}
                    </div>
                    <div class="toast-body">{{ message }}</div>
                    <button type="button" class="toast-close" aria-label="Dismiss" data-toast-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                    <div class="toast-progress" aria-hidden="true"></div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endwith %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="{{ url_for('static', filename='js/frontend/navbar-scroll.js') }}"></script>
    <script src="{{ url_for('static', filename='js/frontend/toasts.js') }}"></script>
    {% block content %}
    {% endblock %}
</body>
</html>